<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Только debug: кладёт текст в буфер обмена для скриптов смоука (adb shell input не умеет кириллицу) -->
        <receiver android:name="ru.neurosteno.app.DebugClipReceiver" android:exported="true">
            <intent-filter>
                <action android:name="ru.neurosteno.app.DEBUG_CLIP" />
            </intent-filter>
        </receiver>
        <receiver android:name="ru.neurosteno.app.DebugStyleReceiver" android:exported="true">
            <intent-filter>
                <action android:name="ru.neurosteno.app.DEBUG_ACCENT" />
            </intent-filter>
        </receiver>
        <receiver android:name="ru.neurosteno.app.DebugMicReceiver" android:exported="true">
            <intent-filter>
                <action android:name="ru.neurosteno.app.DEBUG_MIC_WAV" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
