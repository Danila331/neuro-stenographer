{
 "version": 1,
 "description": "Aligner reference cases (ARCHITECTURE §5). words/turns/params -> utterances. Speaker ids are renumbered speaker_1..N by first appearance. All times in ms.",
 "cases": [
  {
   "name": "empty",
   "description": "no words -> no utterances",
   "params": {
    "max_gap_ms": 1500,
    "min_island_words": 1,
    "min_island_ms": 400
   },
   "words": [],
   "turns": [
    {
     "speaker": 0,
     "start_ms": 0,
     "end_ms": 1000
    }
   ],
   "expected": []
  },
  {
   "name": "no_turns_single",
   "description": "no turns at all: everyone is speaker_1",
   "params": {
    "max_gap_ms": 1500,
    "min_island_words": 1,
    "min_island_ms": 400
   },
   "words": [
    {
     "text": "добрый",
     "start_ms": 0,
     "end_ms": 400
    },
    {
     "text": "день",
     "start_ms": 450,
     "end_ms": 800
    }
   ],
   "turns": [],
   "expected": [
    {
     "speaker_id": "speaker_1",
     "start_ms": 0,
     "end_ms": 800,
     "text": "добрый день"
    }
   ]
  },
  {
