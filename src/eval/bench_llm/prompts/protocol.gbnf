root ::= "{\"title\":" str ",\"participants\":" parts ",\"topics\":" topics ",\"decisions\":" decs ",\"tasks\":" tasks ",\"quotes\":" quotes "}"
str ::= "\"" [^"\\\n]{1,200} "\""
short ::= "\"" [^"\\\n]{1,80} "\""
timecode ::= "\"" [0-9] [0-9] ":" [0-5] [0-9] "\""
speaker ::= "\"speaker_" [1-9] "\""
parts ::= "[" part ("," part){0,5} "]"
part ::= "{\"speaker\":" speaker ",\"role\":" short "}"
topics ::= "[" topic ("," topic){0,5} "]"
topic ::= "{\"title\":" short ",\"summary\":" str "}"
decs ::= "[" (dec ("," dec){0,7})? "]"
dec ::= "{\"text\":" str ",\"time\":" timecode "}"
tasks ::= "[" (task ("," task){0,7})? "]"
task ::= "{\"who\":" short ",\"text\":" str ",\"due\":" (short | "null") ",\"time\":" timecode "}"
quotes ::= "[" (quote ("," quote){0,4})? "]"
quote ::= "{\"speaker\":" speaker ",\"text\":" str ",\"time\":" timecode "}"
