{"transcript":[{"speaker_id":"speaker_1","start_ms":556,"end_ms":876,"text":"Тихон,"},{"speaker_id":"speaker_2","start_ms":1396,"end_ms":1436,"text":"давай"},{"speaker_id":"speaker_1","start_ms":1676,"end_ms":3476,"text":"посмотрим расходы на рыбу за квартал."},{"speaker_id":"speaker_2","start_ms":3876,"end_ms":6796,"text":"Смотрю, в июле потратили 8 400 ₽,"},{"speaker_id":"speaker_1","start_ms":7076,"end_ms":7676,"text":"а в августе"},{"speaker_id":"speaker_2","start_ms":8036,"end_ms":9556,"text":"11 200."},{"speaker_id":"speaker_1","start_ms":9916,"end_ms":10796,"text":"Почему так выросло?"},{"speaker_id":"speaker_2","start_ms":10956,"end_ms":13676,"text":"Был праздник День рождения старейшины. Купили сёмгу."},{"speaker_id":"speaker_1","start_ms":14401,"end_ms":15761,"text":"Сюму, по чьему решению?"},{"speaker_id":"speaker_2","start_ms":16401,"end_ms":20841,"text":"По-вашему, Василий Петрович, вы сами сказали ни в чём себе не отказывать."},{"speaker_id":"speaker_1","start_ms":21441,"end_ms":22561,"text":"Помню, помню."},{"speaker_id":"speaker_2","start_ms":22841,"end_ms":22881,"text":"Но"},{"speaker_id":"speaker_1","start_ms":23161,"end_ms":23601,"text":"сентябрь..."},{"speaker_id":"speaker_2","start_ms":23961,"end_ms":25401,"text":"9 650."},{"speaker_id":"speaker_1","start_ms":26161,"end_ms":27921,"text":"Тогда за квартал выходит около 30"},{"speaker_id":"speaker_2","start_ms":28281,"end_ms":32700,"text":"000. Точнее, 29 250. Хорошо."},{"speaker_id":"speaker_1","start_ms":33380,"end_ms":35380,"text":"Предлагаю сократить закупку. Семги в бюджет. Это"},{"speaker_id":"speaker_2","start_ms":35500,"end_ms":36980,"text":"невозможно. Коллеги привыкли..."},{"speaker_id":"speaker_1","start_ms":37180,"end_ms":40380,"text":"Привыкли. А бюджет не резиновый. Мяу."},{"speaker_id":"speaker_2","start_ms":41340,"end_ms":44020,"text":"Я подготовлю другой расчёт к пятница."}]}