{
  "_note": "ASR ru: GigaAM v3 CTC int8 — лучший WER (FLEURS 2.75%, ru-asr-dev 6.57%). asr_en: Parakeet-TDT-110m-en (FLEURS en 6.64%). LID: whisper-tiny, 100% ru/en на 10 с. Порог диаризации 0.85 — предварительно (0.5–0.6 дробит спикеров), подтвердить diar-bench. Скорость/RAM ещё не измерены на спокойной машине. Пути — относительно корня моделей.",
  "tier": "hard",
  "num_threads": 6,
  "audio": {
    "sample_rate": 16000,
    "denoise": {
      "enabled": true,
      "model": "denoise/gtcrn_simple.onnx",
      "snr_threshold_db": 12.0
    }
  },
  "vad": {
    "model": "silero-vad/silero_vad.onnx",
    "threshold": 0.45,
    "min_silence_ms": 300,
    "min_speech_ms": 120,
    "pad_ms": 150,
    "max_speech_s": 25.0
  },
  "asr": {
    "engine": "gigaam_ctc",
    "model_dir": "asr/gigaam-v3-ctc-int8",
    "decoding": "greedy_search",
    "max_active_paths": 4,
    "hotwords_file": null,
    "hotwords_score": 1.5,
    "chunk": {
      "max_s": 25.0,
      "min_s": 1.0,
      "overlap_ms": 0
    },
    "second_pass": {
      "engine": "whisper",
      "model_dir": "asr/whisper-large-v3-turbo-int8",
      "trigger": "low_confidence",
      "confidence_threshold": 0.6
    },
    "batch_size": 1,
    "word_tail_ms": 40,
    "word_start_offset_ms": 0,
    "language": "ru"
  },
  "diarization": {
    "segmentation": "diar/pyannote-segmentation-3.0/model.int8.onnx",
    "embedding": "diar/embedding/model.onnx",
    "clustering": {
      "method": "fast_clustering",
      "threshold": 0.85,
      "num_speakers": null,
      "max_speakers": 8
    },
    "min_duration_on_s": 0.2,
    "min_duration_off_s": 0.3,
    "enabled": true,
    "window_shift_ratio": 0.1,
    "num_threads": null
  },
  "align": {
    "max_gap_ms": 1500,
    "min_island_words": 1,
    "min_island_ms": 400
  },
  "punctuation": {
    "source": "llm",
    "model": null
  },
  "llm": {
    "model": "llm/qwen3-4b-q4_k_m.gguf",
    "n_ctx": 4096,
    "n_threads": 4,
    "gpu_layers": 99,
    "punctuation": true,
    "speaker_fix": true,
    "summary": true,
    "time_budget_rtf": 0.15
  },
  "normalization": {
    "numbers": "as_is",
    "yo_to_e": false,
    "case": "as_is"
  },
  "language": {
    "mode": "auto",
    "lid_model": "asr/whisper-tiny-int8",
    "lid_seconds": 10
  },
  "asr_en": {
    "engine": "nemo_tdt",
    "model_dir": "asr/parakeet-tdt-110m-en-int8",
    "decoding": "greedy_search",
    "chunk": {
      "max_s": 25.0,
      "min_s": 1.0,
      "overlap_ms": 0
    },
    "language": "en"
  }
}
