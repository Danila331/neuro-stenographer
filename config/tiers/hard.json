{
  "_note": "ASR ru: GigaAM v3 RNNT с пунктуацией (int8) — лучший на диалогах и по WER norm (synth test 16.8%), и по WER со знаками (31% против 45% у моделей без знаков; просодия по паузам — 23–25%). Нормализация громкости peak: на тихих записях WER 35%→13%, на обычных без потерь. asr_en: Parakeet-TDT-110m-en. LID: whisper-tiny. Порог диаризации 0.85 — предварительно. Скорость/RAM финально — по отчёту asr-bench и эмулятору.",
  "tier": "hard",
  "num_threads": 6,
  "audio": {
    "sample_rate": 16000,
    "denoise": {
      "enabled": false,
      "model": "denoise/gtcrn_simple.onnx",
      "snr_threshold_db": 12.0
    },
    "normalize_gain": {
      "enabled": true,
      "mode": "peak",
      "peak_dbfs": -1.0,
      "max_gain_db": 40.0,
      "skip_if_peak_below_dbfs": -85.0,
      "max_attenuation_db": 6.0,
      "scope": "asr"
    }
  },
  "vad": {
    "model": "silero-vad/silero_vad.onnx",
    "threshold": 0.3,
    "min_silence_ms": 300,
    "min_speech_ms": 120,
    "pad_ms": 150,
    "max_speech_s": 25.0,
    "rescue": {
      "enabled": true,
      "snr_db": 10,
      "abs_floor_db": -50,
      "bridge_ms": 300,
      "min_ms": 600,
      "margin_ms": 200
    },
    "chunking": "pack"
  },
  "asr": {
    "engine": "gigaam_rnnt",
    "model_dir": "asr/gigaam-v3-rnnt-punct-int8",
    "decoding": "greedy_search",
    "max_active_paths": 4,
    "hotwords_file": null,
    "hotwords_score": 1.5,
    "chunk": {
      "max_s": 25.0,
      "min_s": 1.0,
      "overlap_ms": 0
    },
    "second_pass": null,
    "batch_size": 1,
    "word_tail_ms": 40,
    "word_start_offset_ms": -30,
    "language": "ru"
  },
  "diarization": {
    "segmentation": "diar/pyannote-segmentation-3.0/model.int8.onnx",
    "embedding": "diar/emb-eres2netv2/model.onnx",
    "clustering": {
      "method": "fast_clustering",
      "threshold": 0.5,
      "num_speakers": null,
      "max_speakers": 8
    },
    "min_duration_on_s": 0.2,
    "min_duration_off_s": 0.3,
    "enabled": true,
    "window_shift_ratio": 1.0,
    "num_threads": null,
    "relabel": {
      "enabled": true,
      "gap_ms": 200,
      "max_unit_ms": 12000,
      "split_min_side_ms": 300,
      "pad_ms": 40,
      "embed_max_s": 10,
      "min_reliable_ms": 800,
      "k_min": 2,
      "k_max": 6,
      "max_cluster_units": 400,
      "refine": 1,
      "k1_silhouette_thr": 0.1,
      "_pending_k1": "защита от монологов: подобрать порог (refpipe)"
    }
  },
  "align": {
    "max_gap_ms": 1500,
    "min_island_words": 1,
    "min_island_ms": 400
  },
  "punctuation": {
    "source": "asr_native",
    "model": null
  },
  "llm": {
    "model": "llm/qwen3-4b-q4_k_m.gguf",
    "n_ctx": 4096,
    "n_threads": 4,
    "gpu_layers": 0,
    "punctuation": false,
    "speaker_fix": false,
    "summary": true,
    "no_repack": true,
    "flash_attn": true,
    "kv_cache_type": "q8_0",
    "use_mmap": true,
    "protocol_mode": "chunk_merge",
    "filter_quotes": true,
    "qa_chunk_budget_ratio": 0.25,
    "quality": "full"
  },
  "normalization": {
    "numbers": "as_is",
    "yo_to_e": false,
    "case": "as_is"
  },
  "language": {
    "mode": "auto",
    "lid_model": "asr/whisper-tiny-int8",
    "lid_seconds": 10,
    "per_chunk": true
  },
  "asr_en": {
    "engine": "nemo_tdt",
    "model_dir": "asr/parakeet-tdt-110m-en-int8",
    "decoding": "greedy_search",
    "chunk": {
      "max_s": 20.0,
      "min_s": 1.0,
      "overlap_ms": 0
    },
    "language": "en"
  },
  "postprocess": {
    "numbers": "as_is",
    "drop_tiny_chunks": {
      "enabled": true,
      "max_chars": 2
    },
    "strip_dashes": "after_terminal"
  }
}
