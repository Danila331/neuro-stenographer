{
  "_note": "ASR ru: GigaAM v3 RNNT с пунктуацией (int8) — лучший на диалогах и по WER norm (synth test 16.8%), и по WER со знаками (31% против 45% у моделей без знаков; просодия по паузам — 23–25%). Нормализация громкости peak: на тихих записях WER 35%→13%, на обычных без потерь. asr_en: Parakeet-TDT-110m-en. LID: whisper-tiny. Порог диаризации 0.85 — предварительно. Скорость/RAM финально — по отчёту asr-bench и эмулятору.",
  "tier": "medium",
  "num_threads": 4,
  "audio": {
    "sample_rate": 16000,
    "denoise": {
      "enabled": false,
      "model": null,
      "snr_threshold_db": 12.0
    },
    "normalize_gain": {
      "enabled": true,
      "mode": "peak",
      "peak_dbfs": -1.0,
      "max_gain_db": 40.0,
      "skip_if_peak_below_dbfs": -85.0
    }
  },
  "vad": {
    "model": "silero-vad/silero_vad.onnx",
    "threshold": 0.45,
    "min_silence_ms": 300,
    "min_speech_ms": 120,
    "pad_ms": 150,
    "max_speech_s": 25.0
  },
  "asr": {
    "engine": "gigaam_rnnt",
    "model_dir": "asr/gigaam-v3-rnnt-punct-int8",
    "decoding": "greedy_search",
    "max_active_paths": 4,
    "hotwords_file": null,
    "hotwords_score": 1.5,
    "chunk": {
      "max_s": 20.0,
      "min_s": 1.0,
      "overlap_ms": 0
    },
    "second_pass": null,
    "batch_size": 1,
    "word_tail_ms": 40,
    "word_start_offset_ms": -30,
    "language": "ru"
  },
  "diarization": {
    "segmentation": "diar/pyannote-segmentation-3.0/model.int8.onnx",
    "embedding": "diar/embedding/model.onnx",
    "clustering": {
      "method": "fast_clustering",
      "threshold": 0.85,
      "num_speakers": null,
      "max_speakers": 8
    },
    "min_duration_on_s": 0.2,
    "min_duration_off_s": 0.3,
    "enabled": true,
    "window_shift_ratio": 0.1,
    "num_threads": null
  },
  "align": {
    "max_gap_ms": 1500,
    "min_island_words": 1,
    "min_island_ms": 400
  },
  "punctuation": {
    "source": "asr_native",
    "model": null
  },
  "llm": {
    "model": "llm/qwen3-1.7b-q4_k_m.gguf",
    "n_ctx": 4096,
    "n_threads": 4,
    "gpu_layers": 0,
    "punctuation": false,
    "speaker_fix": false,
    "summary": true,
    "time_budget_rtf": 0.15
  },
  "normalization": {
    "numbers": "as_is",
    "yo_to_e": false,
    "case": "as_is"
  },
  "language": {
    "mode": "auto",
    "lid_model": "asr/whisper-tiny-int8",
    "lid_seconds": 10,
    "per_chunk": true
  },
  "asr_en": {
    "engine": "nemo_tdt",
    "model_dir": "asr/parakeet-tdt-110m-en-int8",
    "decoding": "greedy_search",
    "chunk": {
      "max_s": 20.0,
      "min_s": 1.0,
      "overlap_ms": 0
    },
    "language": "en"
  },
  "postprocess": {
    "numbers": "as_is",
    "drop_tiny_chunks": {
      "enabled": true,
      "max_chars": 2
    }
  }
}
